@model IEnumerable<Invoice>
@{ ViewData["Title"] = "Invoices"; }

<div class="page-head">
    <div>
        <h1>Invoices</h1>
        <div class="page-caption">Tenant billing and collections</div>
    </div>
    <div class="head-actions">
        <a class="btn btn-primary" asp-action="Create">New Invoice</a>
    </div>
</div>

@{
    decimal invoiced = ViewBag.InvoicedTotal ?? 0m;
    decimal collected = ViewBag.CollectedTotal ?? 0m;
    decimal outstanding = ViewBag.OutstandingTotal ?? 0m;
}

<div class="stat-grid">
    <div class="stat-card">
        <span class="icon-chip blue">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
        </span>
        <div>
            <div class="stat-label">Invoiced</div>
            <div class="stat-value">@invoiced.ToString("C")</div>
            <div class="stat-sub">All invoices</div>
        </div>
    </div>
    <div class="stat-card">
        <span class="icon-chip green">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
        </span>
        <div>
            <div class="stat-label">Collected</div>
            <div class="stat-value">@collected.ToString("C")</div>
            <div class="stat-sub">Payments received</div>
        </div>
    </div>
    <div class="stat-card">
        <span class="icon-chip amber">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
        </span>
        <div>
            <div class="stat-label">Outstanding</div>
            <div class="stat-value">@outstanding.ToString("C")</div>
            <div class="stat-sub">Still to collect</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Invoice</th>
                    <th>Tenant</th>
                    <th>Date</th>
                    <th>Due</th>
                    <th class="text-end">Total</th>
                    <th class="text-end">Paid</th>
                    <th class="text-end">Balance</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var invoice in Model)
                {
                    var statusClass = (invoice.Status ?? "") switch
                    {
                        "Paid" => "badge-soft-success",
                        "Partial" => "badge-soft-warning",
                        "Draft" => "badge-soft-neutral",
                        _ => "badge-soft-brand"
                    };
                    <tr>
                        <td><a class="cell-title" asp-action="Details" asp-route-id="@invoice.Id">@invoice.InvoiceNumber</a></td>
                        <td><span class="cell-sub">@invoice.Tenant?.FullName</span></td>
                        <td>@invoice.InvoiceDate.ToString("MMM dd, yyyy")</td>
                        <td><span class="cell-sub">@invoice.DueDate?.ToString("MMM dd, yyyy")</span></td>
                        <td class="text-end"><span class="fw-semibold">@invoice.TotalAmount.ToString("C")</span></td>
                        <td class="text-end">@invoice.AmountPaid.ToString("C")</td>
                        <td class="text-end">
                            <span class="@(invoice.Balance > 0 ? "amount-expense" : "amount-income")">@invoice.Balance.ToString("C")</span>
                        </td>
                        <td><span class="badge @statusClass">@invoice.Status</span></td>
                        <td class="text-end">
                            <div class="btn-group">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@invoice.Id">View</a>
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@invoice.Id">Edit</a>
                                <form asp-action="Delete" asp-route-id="@invoice.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this invoice?');">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Any())
    {
        <div class="empty-state">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
            <div class="empty-title">No invoices yet</div>
            <div class="empty-sub">Create an invoice to start billing a tenant.</div>
        </div>
    }
</div>
