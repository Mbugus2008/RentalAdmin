@model Rental.ViewModels.InvoicePaymentViewModel
@{ ViewData["Title"] = "Record Payment"; }

<div class="page-head">
    <div>
        <div class="crumb"><a asp-action="Index">Invoices</a> / <a asp-action="Details" asp-route-id="@Model.InvoiceId">@Model.InvoiceNumber</a> / <span>Payment</span></div>
        <h1>Record Payment</h1>
        <div class="page-caption">@Model.TenantName</div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-7">
        <div class="card">
            <div class="card-body">
                <form asp-action="RecordPayment" method="post">
                    <input type="hidden" asp-for="InvoiceId" />
                    <div class="form-section-title">Payment details</div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Amount" class="form-label"></label>
                            <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" />
                            <span asp-validation-for="Amount" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PaymentDate" class="form-label"></label>
                            <input asp-for="PaymentDate" class="form-control" type="date" />
                            <span asp-validation-for="PaymentDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Method" class="form-label"></label>
                            <select asp-for="Method" class="form-select">
                                <option value="M-PESA">M-PESA</option>
                                <option value="Bank Transfer">Bank Transfer</option>
                                <option value="Cash">Cash</option>
                                <option value="Cheque">Cheque</option>
                                <option value="Card">Card</option>
                            </select>
                            <span asp-validation-for="Method" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Notes" class="form-label"></label>
                            <input asp-for="Notes" class="form-control" placeholder="e.g. M-PESA ref QK74X" />
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-actions">
                        <a class="btn btn-secondary" asp-action="Details" asp-route-id="@Model.InvoiceId">Cancel</a>
                        <button type="submit" class="btn btn-primary">Record Payment</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-5">
        <div class="card h-100">
            <div class="card-header">Invoice</div>
            <div class="card-body">
                <div class="detail-list">
                    <div class="detail-row"><span class="k">Invoice</span><span class="v">@Model.InvoiceNumber</span></div>
                    <div class="detail-row"><span class="k">Tenant</span><span class="v">@Model.TenantName</span></div>
                    <div class="detail-row">
                        <span class="k">Outstanding balance</span>
                        <span class="v"><span class="amount-expense">@Model.Balance.ToString("C")</span></span>
                    </div>
                </div>
                <p class="muted-note mt-3 mb-0">Recording a payment updates the invoice status and books a matching income transaction in the ledger.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
