@model Rental.ViewModels.InvoiceFormViewModel
@{ ViewData["Title"] = "Edit Invoice"; }

<div class="page-head">
    <div>
        <div class="crumb"><a asp-action="Index">Invoices</a> / <span>Edit</span></div>
        <h1>Edit Invoice</h1>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="form-section-title">Invoice details</div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="TenantId" class="form-label"></label>
                    @{ var tenants = ViewData["TenantId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList; }
                    <select asp-for="TenantId" class="form-select" asp-items="tenants">
                        <option value="">— Select tenant —</option>
                    </select>
                    <span asp-validation-for="TenantId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="PropertyId" class="form-label"></label>
                    @{ var properties = ViewData["PropertyId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList; }
                    <select asp-for="PropertyId" class="form-select" asp-items="properties">
                        <option value="">— None —</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="InvoiceDate" class="form-label"></label>
                    <input asp-for="InvoiceDate" class="form-control" type="date" />
                    <span asp-validation-for="InvoiceDate" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="DueDate" class="form-label"></label>
                    <input asp-for="DueDate" class="form-control" type="date" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" class="form-select">
                        <option value="Sent">Sent</option>
                        <option value="Draft">Draft</option>
                        <option value="Partial">Partial</option>
                        <option value="Paid">Paid</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="AmountPaid" class="form-label"></label>
                    <input asp-for="AmountPaid" class="form-control" type="number" step="0.01" min="0" />
                    <span asp-validation-for="AmountPaid" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>
            </div>

            <div class="form-section-title" style="margin-top: 1.6rem;">Invoice lines</div>
            <div class="qc">
                <button type="button" class="btn btn-sm btn-outline-primary" data-quick="Rent">+ Rent</button>
                <button type="button" class="btn btn-sm btn-outline-primary" data-quick="Water">+ Water</button>
                <button type="button" class="btn btn-sm btn-outline-primary" data-quick="Garbage">+ Garbage</button>
                <button type="button" class="btn btn-sm btn-outline-primary" data-quick="Service Charge">+ Service Charge</button>
                <button type="button" class="btn btn-sm btn-outline-primary" data-quick="Security">+ Security</button>
            </div>
            <div class="lines-editor mt-3" id="lines">
                @for (var i = 0; i < Model.Lines.Count; i++)
                {
                    <div class="line-row">
                        <input name="Lines[@i].Description" value="@Model.Lines[i].Description" class="form-control" placeholder="Description" />
                        <input name="Lines[@i].Amount" value="@Model.Lines[i].Amount" type="number" step="0.01" min="0" class="form-control amount-input" placeholder="0.00" />
                        <button type="button" class="btn-icon remove-line" title="Remove line" aria-label="Remove line">&times;</button>
                    </div>
                }
            </div>
            <div class="lines-footer">
                <button type="button" id="addLine" class="btn btn-sm btn-outline-secondary">Add line</button>
                <div class="lines-total">Total: <span id="linesTotal">0.00</span></div>
            </div>

            <div class="form-actions">
                <a class="btn btn-secondary" asp-action="Index">Cancel</a>
                <button type="submit" class="btn btn-primary">Update Invoice</button>
            </div>
        </form>
    </div>
</div>

<template id="lineTemplate">
    <div class="line-row">
        <input name="Lines[0].Description" class="form-control" placeholder="Description" />
        <input name="Lines[0].Amount" type="number" step="0.01" min="0" class="form-control amount-input" placeholder="0.00" />
        <button type="button" class="btn-icon remove-line" title="Remove line" aria-label="Remove line">&times;</button>
    </div>
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_LinesEditorScripts" />
}
