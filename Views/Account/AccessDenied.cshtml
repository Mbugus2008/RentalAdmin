@{
    ViewData["Title"] = "Access denied";
}

<div class="page-head">
    <div>
        <h1>Access restricted</h1>
        <div class="crumb"><a asp-controller="Home" asp-action="Index">Dashboard</a> / Access denied</div>
    </div>
</div>

<div class="card" style="max-width: 560px;">
    <div class="card-body">
        <div class="empty-state" style="padding: 1rem 0 1.4rem;">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
            <div class="empty-title">You don't have access to that page</div>
            <div class="empty-sub">Your user type (@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value) doesn't include this area. Ask an administrator if you need access.</div>
        </div>
        <div class="form-actions">
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to dashboard</a>
        </div>
    </div>
</div>
