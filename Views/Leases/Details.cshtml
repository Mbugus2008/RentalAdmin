@model Lease
@{
    ViewData["Title"] = "Lease Details";
}

<div class="page-head">
    <div>
        <div class="crumb"><a asp-action="Index">Leases</a> / <span>Details</span></div>
        <h1>Lease for @Model.Property?.Name</h1>
    </div>
    <div class="head-actions">
        <a class="btn btn-secondary" asp-action="Index">Back</a>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header">Tenant</div>
            <div class="card-body">
                <div class="cell-person mb-2">
                    <span class="avatar">@string.Join("", (Model.Tenant?.FullName ?? "?").Split(' ').Take(2).Select(p => p.FirstOrDefault()))</span>
                    <span class="fw-semibold">@Model.Tenant?.FullName</span>
                </div>
                <div class="detail-list">
                    <div class="detail-row"><span class="k">Email</span><span class="v">@Model.Tenant?.Email</span></div>
                    <div class="detail-row"><span class="k">Phone</span><span class="v">@Model.Tenant?.Phone</span></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header">Term</div>
            <div class="card-body">
                <div class="detail-list">
                    <div class="detail-row"><span class="k">Start</span><span class="v">@Model.StartDate.ToString("MMM dd, yyyy")</span></div>
                    <div class="detail-row"><span class="k">End</span><span class="v">@Model.EndDate?.ToString("MMM dd, yyyy")</span></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header">Financials</div>
            <div class="card-body">
                <div class="detail-list">
                    <div class="detail-row"><span class="k">Monthly rent</span><span class="v">@Model.MonthlyRent.ToString("C")</span></div>
                    <div class="detail-row"><span class="k">Status</span><span class="v">
                        @{
                            var statusClass = (Model.Status ?? "") switch
                            {
                                "Active" => "badge-soft-success",
                                "Pending Renewal" => "badge-soft-warning",
                                "Expired" => "badge-soft-danger",
                                _ => "badge-soft-info"
                            };
                        }
                        <span class="badge @statusClass">@Model.Status</span>
                    </span></div>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="section-title">Payments</span>
        <a class="btn btn-outline-primary btn-sm" asp-controller="Payments" asp-action="Create">Record Payment</a>
    </div>
    @if (Model.Payments.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Amount</th>
                        <th>Method</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in Model.Payments.OrderByDescending(p => p.PaymentDate))
                    {
                        <tr>
                            <td>@payment.PaymentDate.ToString("MMM dd, yyyy")</td>
                            <td><span class="fw-semibold">@payment.Amount.ToString("C")</span></td>
                            <td><span class="badge badge-soft-brand">@payment.Method</span></td>
                            <td><span class="cell-sub">@payment.Notes</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="1" y="4" width="22" height="16" rx="2" /><line x1="1" y1="10" x2="23" y2="10" /></svg>
            <div class="empty-title">No payments yet</div>
            <div class="empty-sub">No payments recorded for this lease.</div>
        </div>
    }
</section>
