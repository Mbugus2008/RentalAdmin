@{
    ViewData["Title"] = "Rental Manager — property management for Kenyan landlords";
    Layout = "_PublicLayout";
}

<!-- Hero -->
<section class="landing-hero">
    <div class="landing-hero-inner">
        <div class="hero-copy">
            <span class="hero-badge">Property management &middot; Kenya</span>
            <h1>Every unit, tenant and shilling &mdash; <span class="grad">under control.</span></h1>
            <p class="lead">
                Rental Manager brings your properties, leases, invoices and M-PESA payments
                into one clean console &mdash; with a companion Android app for landlords on the go.
            </p>
            <div class="hero-cta">
                <a class="btn-hero-primary" asp-controller="Account" asp-action="Login">Open the admin console</a>
                <a class="btn-hero-ghost" href="#features">Explore features</a>
            </div>
            <ul class="hero-points">
                <li>KSh &amp; M-PESA ready</li>
                <li>Unit-level tracking</li>
                <li>Balances &amp; receipts</li>
                <li>Reports &amp; arrears</li>
            </ul>
        </div>
        <div class="hero-shot">
            <div class="browser-frame">
                <div class="browser-top"><span></span><span></span><span></span></div>
                <img src="~/img/screens/dashboard.png" alt="Rental Manager dashboard showing portfolio KPIs and upcoming lease expirations" />
            </div>
        </div>
    </div>
</section>

<!-- Features -->
<section class="landing-section" id="features">
    <div class="landing-container">
        <div class="section-head">
            <h2>Everything you need to run the portfolio</h2>
            <p>Stop juggling notebooks, spreadsheets and WhatsApp reminders. Rental Manager keeps it all in one place.</p>
        </div>
        <div class="feature-grid">
            <div class="feature-card">
                <span class="feature-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3 9.5 12 3l9 6.5" /><path d="M5 10v10h14V10" /><path d="M9 20v-6h6v6" />
                    </svg>
                </span>
                <h3>Properties &amp; units</h3>
                <p>Track every house, block and unit with occupancy and rent at a glance.</p>
            </div>
            <div class="feature-card">
                <span class="feature-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                </span>
                <h3>Tenants &amp; leases</h3>
                <p>Move-ins, deposits and renewals stay on schedule &mdash; expirations never slip through.</p>
            </div>
            <div class="feature-card">
                <span class="feature-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1z" /><line x1="8" y1="8" x2="16" y2="8" /><line x1="8" y1="12" x2="16" y2="12" />
                    </svg>
                </span>
                <h3>Invoices &amp; billing</h3>
                <p>Bill rent, water and garbage in KSh with numbered invoices and partial-payment tracking.</p>
            </div>
            <div class="feature-card">
                <span class="feature-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="1" y="4" width="22" height="16" rx="2" /><line x1="1" y1="10" x2="23" y2="10" />
                    </svg>
                </span>
                <h3>M-PESA payments</h3>
                <p>Record payments as they arrive and watch tenant balances update instantly.</p>
            </div>
            <div class="feature-card">
                <span class="feature-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
                    </svg>
                </span>
                <h3>Maintenance requests</h3>
                <p>Every repair request knows its house or room number, priority and status.</p>
            </div>
            <div class="feature-card">
                <span class="feature-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21.21 15.89A10 10 0 1 1 8 2.83" /><path d="M22 12A10 10 0 0 0 12 2v10z" />
                    </svg>
                </span>
                <h3>Reports that matter</h3>
                <p>Revenue, expenses, occupancy and outstanding balances in one view, ready to act on.</p>
            </div>
        </div>
    </div>
</section>

<!-- Screenshots -->
<section class="landing-section alt" id="screens">
    <div class="landing-container">
        <div class="section-head">
            <h2>Take a look inside</h2>
            <p>Real screens from the admin console &mdash; dashboard, maintenance, billing and reports.</p>
        </div>
        <div class="shot-grid">
            <figure class="shot">
                <img src="~/img/screens/maintenance.png" alt="Maintenance requests list with unit numbers, priorities and statuses" />
                <figcaption class="shot-caption">
                    <strong>Maintenance, pinned to its unit</strong>
                    <span>Requests carry the house or room number, priority, assignee and cost.</span>
                </figcaption>
            </figure>
            <figure class="shot">
                <img src="~/img/screens/invoices.png" alt="Invoice list showing Kenyan Shilling amounts, partial payments and balances" />
                <figcaption class="shot-caption">
                    <strong>Billing in Kenyan Shillings</strong>
                    <span>Numbered invoices, partial payments and who still owes what.</span>
                </figcaption>
            </figure>
            <figure class="shot">
                <img src="~/img/screens/reports.png" alt="Reports page showing revenue, expenses, net income and occupancy" />
                <figcaption class="shot-caption">
                    <strong>Know your numbers</strong>
                    <span>Revenue, expenses, arrears and occupancy for the whole portfolio.</span>
                </figcaption>
            </figure>
            <figure class="shot">
                <img src="~/img/screens/dashboard.png" alt="Dashboard with portfolio stats and upcoming lease expirations" />
                <figcaption class="shot-caption">
                    <strong>Your day at a glance</strong>
                    <span>Monthly rent, collections and leases expiring soon &mdash; the moment you sign in.</span>
                </figcaption>
            </figure>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="landing-cta">
    <div class="landing-container">
        <h2>Ready to get your rentals organised?</h2>
        <p>Sign in to the admin console today. The Rental Manager Android app is coming soon to Google Play.</p>
        <a class="btn-cta-light" asp-controller="Account" asp-action="Login">Sign in to the console</a>
    </div>
</section>
