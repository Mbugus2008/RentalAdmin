@model AppSettings
@{ ViewData["Title"] = "Settings"; }

<div class="page-head">
    <div>
        <h1>Settings</h1>
        <div class="page-caption">Billing rates used across invoices</div>
    </div>
</div>

@if (TempData["SettingsSaved"] != null)
{
    <div class="alert-soft success">Settings saved.</div>
}

<div class="row g-3">
    <div class="col-md-7">
        <div class="card">
            <div class="card-body">
                <form asp-action="Index" method="post">
                    <div class="form-section-title">Billing rates</div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="WaterRatePerUnit" class="form-label"></label>
                            <input asp-for="WaterRatePerUnit" class="form-control" type="number" step="0.01" min="0" />
                            <span asp-validation-for="WaterRatePerUnit" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="GarbageFee" class="form-label"></label>
                            <input asp-for="GarbageFee" class="form-control" type="number" step="0.01" min="0" />
                            <span asp-validation-for="GarbageFee" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">Save Settings</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-5">
        <div class="card h-100">
            <div class="card-header">Where these are used</div>
            <div class="card-body">
                <div class="detail-list">
                    <div class="detail-row"><span class="k">Water per unit</span><span class="v">@Model.WaterRatePerUnit.ToString("C")</span></div>
                    <div class="detail-row"><span class="k">Garbage fee</span><span class="v">@Model.GarbageFee.ToString("C")</span></div>
                    <div class="detail-row"><span class="k">Last updated</span><span class="v">@Model.UpdatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</span></div>
                </div>
                <p class="muted-note mt-3 mb-0">
                    These rates power the presets when composing invoices in the mobile app and in the
                    <a asp-controller="Invoices" asp-action="Create">invoice editor</a> — the Water chip bills units × rate and
                    the Garbage chip applies the monthly fee.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
