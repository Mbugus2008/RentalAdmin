@model IEnumerable<Property>
@{
    ViewData["Title"] = "Properties";
}

<div class="page-head">
    <div>
        <h1>Properties</h1>
        <div class="page-caption">Portfolio of managed units</div>
    </div>
    <div class="head-actions">
        <a class="btn btn-primary" asp-action="Create">Add Property</a>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Address</th>
                    <th>Units</th>
                    <th>Leases</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var property in Model)
                {
                    <tr>
                        <td><a class="cell-title" asp-action="Details" asp-route-id="@property.Id">@property.Name</a></td>
                        <td>
                            <div>@property.Address</div>
                            <div class="cell-sub">@property.City, @property.State @property.ZipCode</div>
                        </td>
                        <td><span class="chip">@property.Units units</span></td>
                        <td><span class="chip">@property.Leases.Count leases</span></td>
                        <td class="text-end">
                            <div class="btn-group">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@property.Id">Details</a>
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@property.Id">Edit</a>
                                <form asp-action="Delete" asp-route-id="@property.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this property?');">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Any())
    {
        <div class="empty-state">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9.5 12 3l9 6.5" /><path d="M5 10v10h14V10" /><path d="M9 20v-6h6v6" /></svg>
            <div class="empty-title">No properties yet</div>
            <div class="empty-sub">Add your first property to get started.</div>
        </div>
    }
</div>
