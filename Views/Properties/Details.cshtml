@model Property
@{
    ViewData["Title"] = "Property Details";
}

<div class="page-head">
    <div>
        <div class="crumb"><a asp-action="Index">Properties</a> / <span>Details</span></div>
        <h1>@Model.Name</h1>
    </div>
    <div class="head-actions">
        <a class="btn btn-secondary" asp-action="Index">Back</a>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">Address</div>
            <div class="card-body">
                <div class="detail-list">
                    <div class="detail-row"><span class="k">Street</span><span class="v">@Model.Address</span></div>
                    <div class="detail-row"><span class="k">City</span><span class="v">@Model.City, @Model.State @Model.ZipCode</span></div>
                    <div class="detail-row"><span class="k">Units</span><span class="v">@Model.Units</span></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">Notes</div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <p class="mb-0">@Model.Notes</p>
                }
                else
                {
                    <p class="muted-note mb-0">No notes recorded.</p>
                }
            </div>
        </div>
    </div>
</div>

<section class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="section-title">Leases</span>
        <a class="btn btn-outline-primary btn-sm" asp-controller="Leases" asp-action="Create">Add Lease</a>
    </div>
    @if (Model.Leases.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Tenant</th>
                        <th>Start</th>
                        <th>End</th>
                        <th>Rent</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lease in Model.Leases.OrderByDescending(l => l.StartDate))
                    {
                        <tr>
                            <td>
                                <div class="cell-person">
                                    <span class="avatar avatar-sm">@string.Join("", (lease.Tenant?.FullName ?? "?").Split(' ').Take(2).Select(p => p.FirstOrDefault()))</span>
                                    <span>@lease.Tenant?.FullName</span>
                                </div>
                            </td>
                            <td>@lease.StartDate.ToString("MMM dd, yyyy")</td>
                            <td>@lease.EndDate?.ToString("MMM dd, yyyy")</td>
                            <td><span class="fw-semibold">@lease.MonthlyRent.ToString("C")</span></td>
                            <td>
                                @{
                                    var statusClass = (lease.Status ?? "") switch
                                    {
                                        "Active" => "badge-soft-success",
                                        "Pending Renewal" => "badge-soft-warning",
                                        "Expired" => "badge-soft-danger",
                                        _ => "badge-soft-info"
                                    };
                                }
                                <span class="badge @statusClass">@lease.Status</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
            <div class="empty-title">No leases yet</div>
            <div class="empty-sub">No leases associated with this property yet.</div>
        </div>
    }
</section>
