@model IEnumerable<MaintenanceRequest>
@{ ViewData["Title"] = "Maintenance"; }

<div class="page-head">
    <div>
        <h1>Maintenance</h1>
        <div class="page-caption">Repair and upkeep requests</div>
    </div>
    <div class="head-actions">
        <a class="btn btn-primary" asp-action="Create">New Request</a>
    </div>
</div>

@{
    int openCount = ViewBag.OpenCount ?? 0;
    int inProgressCount = ViewBag.InProgressCount ?? 0;
    int completedCount = ViewBag.CompletedCount ?? 0;
}

<div class="stat-grid">
    <div class="stat-card">
        <span class="icon-chip amber">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
        </span>
        <div>
            <div class="stat-label">Open</div>
            <div class="stat-value">@openCount</div>
            <div class="stat-sub">Awaiting action</div>
        </div>
    </div>
    <div class="stat-card">
        <span class="icon-chip blue">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" /></svg>
        </span>
        <div>
            <div class="stat-label">In progress</div>
            <div class="stat-value">@inProgressCount</div>
            <div class="stat-sub">Being worked on</div>
        </div>
    </div>
    <div class="stat-card">
        <span class="icon-chip green">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
        </span>
        <div>
            <div class="stat-label">Completed</div>
            <div class="stat-value">@completedCount</div>
            <div class="stat-sub">Resolved requests</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Request</th>
                    <th>Property</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Assigned to</th>
                    <th class="text-end">Est. cost</th>
                    <th>Requested</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model)
                {
                    var priorityClass = (request.Priority ?? "") switch
                    {
                        "Urgent" => "badge-soft-danger",
                        "High" => "badge-soft-warning",
                        "Medium" => "badge-soft-info",
                        _ => "badge-soft-neutral"
                    };
                    var statusClass = (request.Status ?? "") switch
                    {
                        "Completed" => "badge-soft-success",
                        "In Progress" => "badge-soft-info",
                        _ => "badge-soft-warning"
                    };
                    <tr>
                        <td>
                            <div class="cell-title">@request.Title</div>
                            <div class="cell-sub">@(request.Description.Length > 70 ? request.Description.Substring(0, 70) + "…" : request.Description)</div>
                        </td>
                        <td>
                            <span class="cell-sub">@(request.Property?.Name ?? "—")</span>
                            @if (request.UnitId.HasValue && request.UnitId > 0)
                            {
                                <div class="cell-sub"><span class="chip">Unit @request.UnitId</span></div>
                            }
                        </td>
                        <td><span class="badge @priorityClass">@request.Priority</span></td>
                        <td><span class="badge @statusClass">@request.Status</span></td>
                        <td><span class="cell-sub">@(string.IsNullOrWhiteSpace(request.AssignedTo) ? "—" : request.AssignedTo)</span></td>
                        <td class="text-end"><span class="fw-semibold">@(request.EstimatedCost?.ToString("C") ?? "—")</span></td>
                        <td><span class="cell-sub">@request.RequestDate.ToString("MMM dd, yyyy")</span></td>
                        <td class="text-end">
                            <div class="btn-group">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@request.Id">Edit</a>
                                <form asp-action="Delete" asp-route-id="@request.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this request?');">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Any())
    {
        <div class="empty-state">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" /></svg>
            <div class="empty-title">No maintenance requests</div>
            <div class="empty-sub">Nothing needs fixing right now.</div>
        </div>
    }
</div>
