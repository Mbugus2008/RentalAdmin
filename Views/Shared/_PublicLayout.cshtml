@{
    var title = ViewData["Title"] as string ?? "Rental Manager";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title</title>
    <meta name="description" content="Rental Manager keeps your properties, tenants, leases, invoices and M-PESA payments in one place — built for Kenyan landlords and property managers." />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='6' fill='%232563EB'/%3E%3Cpath d='M5 11 12 5.5 19 11v8h-5v-5h-4v5H5z' fill='white'/%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="public-body">
    <header class="public-nav">
        <div class="public-nav-inner">
            <a class="public-brand" href="/">
                <span class="brand-mark">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3 9.5 12 3l9 6.5" />
                        <path d="M5 10v10h14V10" />
                        <path d="M9 20v-6h6v6" />
                    </svg>
                </span>
                <span>
                    <span class="brand-name d-block">Rental Manager</span>
                    <span class="brand-sub">Property management</span>
                </span>
            </a>
            <nav class="public-links">
                <a class="nav-anchor" href="#features">Features</a>
                <a class="nav-anchor" href="#screens">Screenshots</a>
                <a class="btn-signin" asp-controller="Account" asp-action="Login">Sign in</a>
            </nav>
        </div>
    </header>

    @RenderBody()

    <footer class="public-foot">
        <div class="public-foot-inner">
            <div>&copy; @DateTime.Now.Year Rental Manager &mdash; property management for Kenyan landlords.</div>
            <div>Companion Android app coming soon to Google Play &middot; <a asp-controller="Account" asp-action="Login">Admin sign in</a></div>
        </div>
    </footer>

    @RenderSection("Scripts", required: false)
</body>
</html>
