@model RentalDocument
@{ ViewData["Title"] = "Upload Document"; }

<div class="page-head">
    <div>
        <div class="crumb"><a asp-action="Index">Documents</a> / <span>Upload</span></div>
        <h1>Upload Document</h1>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="form-section-title">File</div>
            <div class="file-drop">
                <div>Choose a file (PDF, image, Word, Excel or text — max 10 MB)</div>
                <input type="file" name="file" accept=".pdf,.png,.jpg,.jpeg,.doc,.docx,.xls,.xlsx,.txt" />
                <span class="field-validation-error" data-valmsg-for="file" data-valmsg-replace="true">@Html.ValidationMessage("file")</span>
            </div>

            <div class="form-section-title" style="margin-top: 1.6rem;">Document details</div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" placeholder="e.g. Lease Agreement — Kilimani Heights Unit 3B" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Category" class="form-label"></label>
                    <select asp-for="Category" class="form-select">
                        <option value="Lease Agreement">Lease Agreement</option>
                        <option value="ID / KYC">ID / KYC</option>
                        <option value="Receipt">Receipt</option>
                        <option value="Inspection">Inspection</option>
                        <option value="Insurance">Insurance</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="PropertyId" class="form-label">Property</label>
                    @{ var properties = ViewData["PropertyId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList; }
                    <select asp-for="PropertyId" class="form-select" asp-items="properties">
                        <option value="">— None —</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="TenantId" class="form-label">Tenant</label>
                    @{ var tenants = ViewData["TenantId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList; }
                    <select asp-for="TenantId" class="form-select" asp-items="tenants">
                        <option value="">— None —</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="ExpirationDate" class="form-label"></label>
                    <input asp-for="ExpirationDate" class="form-control" type="date" />
                </div>
                <div class="col-md-8">
                    <label asp-for="Description" class="form-label"></label>
                    <input asp-for="Description" class="form-control" placeholder="Optional note" />
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>
            <div class="form-actions">
                <a class="btn btn-secondary" asp-action="Index">Cancel</a>
                <button type="submit" class="btn btn-primary">Upload Document</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
