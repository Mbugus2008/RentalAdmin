@model IEnumerable<Payment>
@{
    ViewData["Title"] = "Payments";
}

<div class="page-head">
    <div>
        <h1>Payments</h1>
        <div class="page-caption">Rent received and recorded</div>
    </div>
    <div class="head-actions">
        <a class="btn btn-primary" asp-action="Create">Record Payment</a>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Property</th>
                    <th>Tenant</th>
                    <th>Date</th>
                    <th>Amount</th>
                    <th>Method</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var payment in Model)
                {
                    <tr>
                        <td><span class="cell-title">@payment.Lease?.Property?.Name</span></td>
                        <td><span class="cell-sub">@payment.Lease?.Tenant?.FullName</span></td>
                        <td>@payment.PaymentDate.ToString("MMM dd, yyyy")</td>
                        <td><span class="fw-semibold">@payment.Amount.ToString("C")</span></td>
                        <td><span class="badge badge-soft-brand">@payment.Method</span></td>
                        <td class="text-end">
                            <div class="btn-group">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@payment.Id">Edit</a>
                                <form asp-action="Delete" asp-route-id="@payment.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this payment?');">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Any())
    {
        <div class="empty-state">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="1" y="4" width="22" height="16" rx="2" /><line x1="1" y1="10" x2="23" y2="10" /></svg>
            <div class="empty-title">No payments yet</div>
            <div class="empty-sub">Record a payment to start tracking collections.</div>
        </div>
    }
</div>
